# Binaries
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Anchored to the root-built binary only — an unanchored "vaultwarden-k8s-sync"
# also matched the cmd/vaultwarden-k8s-sync/ SOURCE dir, so main.go was never
# tracked (the image only built because docker build ignores .gitignore).
/vaultwarden-k8s-sync

# Test binary / coverage
*.test
*.out
coverage.*

# Go workspace
go.work
go.work.sum

# Vendored deps (not used)
/vendor/

# Local env / secrets — never commit
.env
*.env.local
*.local.yaml
bootstrap-secret.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
